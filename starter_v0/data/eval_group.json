{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "Template để NHÓM tự viết đúng 10 case: 5 single-turn dùng query và 5 multi-turn dùng turns. Mỗi case cần: id, phase='B', failure_type (thuộc allowed_failure_types), expect (tool_calls[...] hoặc no_tool=true), và metadata.what_it_tests.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_timeline_limit",
      "phase": "B",
      "suite": "group",
      "query": "Cho mình 5 tweet mới nhất của Bill Gates.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {"screenname": "billgates", "limit": 5}
          }
        ]
      },
      "metadata": {
        "skill": "timeline_limit",
        "difficulty": "easy",
        "what_it_tests": "Single-turn: map tên Bill Gates thành handle billgates và lấy đúng limit=5." 
      }
    },
    {
      "id": "G02_social_search_top",
      "phase": "B",
      "suite": "group",
      "query": "Tìm các tweet phổ biến nhất về AI ethics.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "social_search",
            "args": {"query": "AI ethics", "search_type": "Top"}
          }
        ]
      },
      "metadata": {
        "skill": "social_search_top",
        "difficulty": "medium",
        "what_it_tests": "Single-turn: chọn social_search và dùng search_type=Top cho tweet phổ biến." 
      }
    },
    {
      "id": "G03_lookup_day_news",
      "phase": "B",
      "suite": "group",
      "query": "Tin tức AI hôm nay có gì nổi bật?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {"query": "AI", "topic": "news", "timeframe": "day"}
          }
        ]
      },
      "metadata": {
        "skill": "lookup_today_news",
        "difficulty": "easy",
        "what_it_tests": "Single-turn: chọn lookup news cho tin tức hôm nay, không phải social_search." 
      }
    },
    {
      "id": "G04_fetch_specific_url",
      "phase": "B",
      "suite": "group",
      "query": "Tóm tắt bài viết này giúp mình: https://openai.com/blog/chatgpt",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "fetch",
            "args": {"url": "https://openai.com/blog/chatgpt"}
          }
        ]
      },
      "metadata": {
        "skill": "fetch_specific_url",
        "difficulty": "easy",
        "what_it_tests": "Single-turn: có URL cụ thể nên gọi fetch, không dùng lookup." 
      }
    },
    {
      "id": "G05_clarify_missing_url",
      "phase": "B",
      "suite": "group",
      "query": "Đọc bài viết này hộ mình.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {"response_type": "text"}
          }
        ]
      },
      "metadata": {
        "skill": "clarify_missing_url",
        "difficulty": "medium",
        "what_it_tests": "Single-turn: thiếu URL nên phải hỏi lại, không đoán bừa." 
      }
    },
    {
      "id": "G06_multi_change_to_web",
      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Tìm tweet về OpenAI trong ngày."},
        {"role": "user", "content": "Không, bỏ Twitter, chỉ cần tin tức web thôi."},
        {"role": "user", "content": "Giữ chủ đề OpenAI và hôm nay."}
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {"query": "OpenAI", "topic": "news", "timeframe": "day"}
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_tool_switch",
        "difficulty": "hard",
        "what_it_tests": "Multi-turn: chuyển từ tweet sang web news theo user sửa request." 
      }
    },
    {
      "id": "G07_multi_handle_and_limit",
      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Lấy 10 tweet mới nhất của Elon Musk."},
        {"role": "user", "content": "Chỉ cần 3 thôi."},
        {"role": "user", "content": "Vẫn là Elon Musk nhé."}
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {"screenname": "elonmusk", "limit": 3}
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_limit_correction",
        "difficulty": "hard",
        "what_it_tests": "Multi-turn: carry forward handle elonmusk và sửa limit từ 10 thành 3." 
      }
    },
    {
      "id": "G08_multi_no_tool_now",
      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Cho mình tin AI hôm nay."},
        {"role": "user", "content": "Đừng tìm nữa, mình chỉ muốn biết khả năng của bạn."},
        {"role": "user", "content": "Bạn có thể làm gì?"}
      ],
      "failure_type": "unnecessary_tool",
      "expect": {
        "no_tool": true
      },
      "metadata": {
        "skill": "multiturn_no_tool",
        "difficulty": "medium",
        "what_it_tests": "Multi-turn: final turn is meta request, should not call any tool." 
      }
    },
    {
      "id": "G09_multi_clarify_url",
      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Tóm tắt bài này hộ mình."},
        {"role": "user", "content": "https://anthropic.com/news/claude"},
        {"role": "user", "content": "Chỉ dùng đúng link này thôi."}
      ],
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "fetch",
            "args": {"url": "https://anthropic.com/news/claude"}
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_url_confirmation",
        "difficulty": "medium",
        "what_it_tests": "Multi-turn: after user provides URL and confirms, call fetch on that URL." 
      }
    },
    {
      "id": "G10_multi_confirm_send",
      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Viết bản tin AI hôm nay và gửi lên Telegram."},
        {"role": "user", "content": "Đợi mình xác nhận xong đã."},
        {"role": "user", "content": "Đừng gửi ngay, hỏi tôi trước."}
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {"response_type": "yes_no"}
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_send_confirmation",
        "difficulty": "hard",
        "what_it_tests": "Multi-turn: user requests Telegram send but asks to wait, so agent must confirm before send." 
      }
    }
  ]
}
